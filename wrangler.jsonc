// Cloudflare Workers settings for the site. It's static files only, with no Worker code: Cloudflare runs the
// build command (sh scripts/build.sh), then the deploy command (npx wrangler deploy), which uploads dist/ and
// reads _headers from it. Not published itself: build.sh copies only the site into dist/.
{
  "name": "portfolio",  // must match the Worker's name in the Cloudflare dashboard
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    // a missing page gets 404.html with a 404 status
    "not_found_handling": "404-page"
  },
  // no portfolio.<account>.workers.dev address: the site answers only at its custom domain, piyushkasle.dev
  "workers_dev": false,
  // no extra public address for every uploaded version
  "preview_urls": false
}
